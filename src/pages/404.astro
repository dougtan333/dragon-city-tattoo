---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | Dragon City Tattoo">
  <section class="min-h-[70vh] flex items-center justify-center">
    <div class="text-center px-6">
      <p class="text-accent text-sm font-medium uppercase tracking-widest mb-4">404</p>
      <h1 class="font-display text-4xl md:text-5xl font-semibold text-ink-50 mb-4">Page not found</h1>
      <p class="text-ink-400 mb-8 max-w-md mx-auto">The page you're looking for doesn't exist. Head back to the homepage to see our work and get in touch.</p>
      <a href="/" class="btn-primary">
        Back to home
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>
</BaseLayout>
