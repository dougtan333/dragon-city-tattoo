</BaseLayout>

<script is:inline>
  // Gallery filter
  var filterBtns = document.querySelectorAll('.filter-chip');
  var galleryItems = document.querySelectorAll('#gallery-grid .gallery-item');
  filterBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var filter = btn.getAttribute('data-filter');
      filterBtns.forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      galleryItems.forEach(function(item) {
        var style = item.getAttribute('data-style') || '';
        var styles = style.split(',');
        item.style.display = (filter === 'all' || styles.indexOf(filter) !== -1) ? '' : 'none';
      });
    });
  });

  // FAQ accordion
  document.querySelectorAll('.faq-toggle').forEach(function(toggle) {
    toggle.addEventListener('click', function() {
      var content = toggle.nextElementSibling;
      var chevron = toggle.querySelector('.faq-chevron');
      var isOpen = toggle.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('.faq-toggle').forEach(function(other) {
        if (other !== toggle) {
          other.setAttribute('aria-expanded', 'false');
          var oc = other.nextElementSibling;
          var och = other.querySelector('.faq-chevron');
          if (oc) oc.style.maxHeight = '0';
          if (och) och.style.transform = '';
        }
      });
      if (isOpen) {
        toggle.setAttribute('aria-expanded', 'false');
        content.style.maxHeight = '0';
        chevron.style.transform = '';
      } else {
        toggle.setAttribute('aria-expanded', 'true');
        content.style.maxHeight = content.scrollHeight + 'px';
        chevron.style.transform = 'rotate(180deg)';
      }
    });
  });

  // Facebook SDK - lazy load only when updates section is visible
  var fbLoaded = false;
  var fbSection = document.getElementById('updates');
  if (fbSection) {
    var fbObserver = new IntersectionObserver(function(entries) {
      if (entries[0].isIntersecting && !fbLoaded) {
        fbLoaded = true;
        var js = document.createElement('script');
        js.id = 'facebook-jssdk';
        js.src = 'https://connect.facebook.net/en_AU/sdk.js#xfbml=1&version=v21.0';
        document.body.appendChild(js);
        fbObserver.disconnect();
      }
    }, { rootMargin: '200px' });
    fbObserver.observe(fbSection);
  }
</script>
