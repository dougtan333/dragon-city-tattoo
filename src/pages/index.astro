---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import { parse } from 'yaml';

const shop = parse(fs.readFileSync('src/content/config/shop.yaml', 'utf-8')) as Record<string, any>;
const artistsRaw = parse(fs.readFileSync('src/content/config/artists.yaml', 'utf-8')) as any;
const galleryRaw = parse(fs.readFileSync('src/content/config/gallery.yaml', 'utf-8')) as any;
const reviewsRaw = parse(fs.readFileSync('src/content/config/reviews.yaml', 'utf-8')) as any;

// Support both bare arrays and Decap CMS format (object with items key)
const artists = Array.isArray(artistsRaw) ? artistsRaw : (artistsRaw?.items || []);
const galleryItems = Array.isArray(galleryRaw) ? galleryRaw : (galleryRaw?.items || []);
const reviews = Array.isArray(reviewsRaw) ? reviewsRaw : (reviewsRaw?.items || []);

const styles = [...new Set(galleryItems.flatMap((item: any) => Array.isArray(item.style) ? item.style : [item.style]))].sort();
---

<BaseLayout>

  <!-- ==================== HERO ==================== -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-surface">
      <div class="absolute inset-0 bg-gradient-to-b from-surface via-surface/80 to-surface"></div>
      <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-accent/5 blur-3xl"></div>
      <div class="absolute bottom-1/3 right-1/4 w-72 h-72 rounded-full bg-gold/3 blur-3xl"></div>
    </div>
    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
      <div class="flex items-center justify-center gap-4 mb-8 animate-fade-in">
        <div class="w-12 h-px bg-accent/60"></div>
        <span class="text-xs font-medium uppercase tracking-[0.2em] text-accent">{shop.address.suburb}, Melbourne</span>
        <div class="w-12 h-px bg-accent/60"></div>
      </div>
      <h1 class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-semibold text-ink-50 leading-[0.95] mb-6 animate-slide-up">
        {shop.name}
      </h1>
      <p class="text-lg md:text-xl text-ink-400 max-w-2xl mx-auto mb-10 animate-slide-up" style="animation-delay: 0.15s">
        {shop.tagline}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up" style="animation-delay: 0.3s">
        <a href={shop.booking_url} class="btn-primary">
          {shop.booking_cta}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="#gallery" class="btn-outline">View our work</a>
      </div>
      {shop.walkins_welcome && (
        <p class="mt-8 text-xs uppercase tracking-widest text-ink-600 animate-fade-in" style="animation-delay: 0.5s">Walk-ins welcome</p>
      )}
    </div>
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-5 h-5 text-ink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
    </div>
  </section>

  <!-- ==================== GALLERY ==================== -->
  <section id="gallery" class="py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="reveal mb-12">
        <span class="text-xs font-medium uppercase tracking-[0.2em] text-accent">Portfolio</span>
        <h2 class="font-display text-4xl md:text-5xl font-semibold text-ink-50 mt-3">Our work</h2>
        <p class="text-ink-400 mt-4 max-w-xl">Every piece tells a story. Browse our artists' latest work across styles.</p>
      </div>
      {shop.features.gallery_filter && (
        <div class="reveal flex flex-wrap gap-2 mb-10" id="gallery-filters">
          <button class="filter-chip active" data-filter="all" aria-label="Show all styles">All</button>
          {styles.map((style: string) => (
            <button class="filter-chip" data-filter={style} aria-label={`Filter by ${style}`}>{style}</button>
          ))}
        </div>
      )}
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4" id="gallery-grid">
        {galleryItems.map((item: any, i: number) => (
          <div class="gallery-item reveal aspect-[3/4] bg-surface-raised" data-style={Array.isArray(item.style) ? item.style.join(',') : item.style} data-index={i} style={`animation-delay: ${i * 0.05}s`}>
            <div class="w-full h-full bg-gradient-to-br from-ink-800 to-ink-900 flex items-center justify-center">
              <div class="text-center px-4">
                <div class="w-12 h-12 mx-auto mb-3 rounded-full border border-ink-700 flex items-center justify-center">
                  <svg class="w-5 h-5 text-ink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </div>
                <p class="text-ink-600 text-xs">{item.title}</p>
              </div>
            </div>
            <div class="overlay">
              <span class="text-xs uppercase tracking-wider text-accent mb-1">{Array.isArray(item.style) ? item.style.join(' · ') : item.style}</span>
              <span class="text-sm font-medium text-ink-100">{item.title}</span>
              <span class="text-xs text-ink-400 mt-1">by {artists.find((a: any) => a.id === item.artist)?.name}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <div class="divider-line max-w-7xl mx-auto"></div>

  <!-- ==================== ARTISTS ==================== -->
  <section id="artists" class="py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="reveal mb-16">
        <span class="text-xs font-medium uppercase tracking-[0.2em] text-accent">The team</span>
        <h2 class="font-display text-4xl md:text-5xl font-semibold text-ink-50 mt-3">Our artists</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        {artists.map((artist: any, i: number) => (
          <div class="artist-card reveal flex flex-col sm:flex-row gap-6 bg-surface-raised border border-ink-800/30 p-6" style={`animation-delay: ${i * 0.1}s`}>
            <div class="w-full sm:w-40 h-48 sm:h-auto flex-shrink-0 bg-ink-900 overflow-hidden">
              <div class="w-full h-full bg-gradient-to-br from-ink-800 to-ink-950 flex items-center justify-center artist-image">
                <div class="w-16 h-16 rounded-full border border-ink-700 flex items-center justify-center">
                  <svg class="w-7 h-7 text-ink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                </div>
              </div>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-display text-xl font-semibold text-ink-50">{artist.name}</h3>
              <p class="text-xs uppercase tracking-wider text-accent mt-1">{artist.role}</p>
              <div class="flex flex-wrap gap-2 mt-3">
                {artist.specialties.map((s: string) => (
                  <span class="text-[10px] uppercase tracking-wider px-2.5 py-1 bg-ink-800/50 text-ink-400 border border-ink-800/60">{s}</span>
                ))}
              </div>
              <p class="text-sm text-ink-400 leading-relaxed mt-4 line-clamp-4">{artist.bio.trim()}</p>
              {artist.instagram && (
                <a href={artist.instagram} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 mt-4 text-xs text-ink-500 hover:text-accent transition-colors">
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                  Follow their work
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <div class="divider-line max-w-7xl mx-auto"></div>

  <!-- ==================== ABOUT ==================== -->
  <section id="about" class="py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div class="reveal">
          <span class="text-xs font-medium uppercase tracking-[0.2em] text-accent">Our story</span>
          <h2 class="font-display text-4xl md:text-5xl font-semibold text-ink-50 mt-3 mb-8">{shop.about.headline}</h2>
          <div class="space-y-5 text-ink-400 leading-relaxed">
            {shop.about.story.split('\n\n').map((paragraph: string) => (
              <p>{paragraph.trim()}</p>
            ))}
          </div>
        </div>
        <div class="space-y-6 reveal" style="animation-delay: 0.2s">
          {shop.about.values.map((value: any, i: number) => (
            <div class="bg-surface-raised border border-ink-800/30 p-6 group hover:border-accent/20 transition-colors">
              <div class="flex items-start gap-4">
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center bg-accent/10 text-accent text-xs font-mono font-medium">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="font-display text-lg font-medium text-ink-100">{value.title}</h3>
                  <p class="text-sm text-ink-400 mt-2 leading-relaxed">{value.description}</p>
                </div>
              </div>
            </div>
          ))}
          <div class="pt-4">
            <a href={shop.booking_url} class="btn-primary">
              {shop.booking_cta}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="divider-line max-w-7xl mx-auto"></div>

  <!-- ==================== REVIEWS ==================== -->
  <section id="reviews" class="py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="reveal mb-12">
        <span class="text-xs font-medium uppercase tracking-[0.2em] text-accent">Testimonials</span>
        <h2 class="font-display text-4xl md:text-5xl font-semibold text-ink-50 mt-3">What our clients say</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {reviews.map((review: any, i: number) => (
          <div class="review-card reveal" style={`animation-delay: ${i * 0.08}s`}>
            <div class="flex gap-0.5 mb-4">
              {Array.from({ length: review.rating }).map(() => (
                <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <p class="text-sm text-ink-300 leading-relaxed mb-6">{review.text}</p>
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-ink-200">{review.name}</p>
                <p class="text-xs text-ink-600 mt-0.5">
                  {review.source} &middot; {new Date(review.date).toLocaleDateString('en-AU', { month: 'short', year: 'numeric' })}
                </p>
              </div>
              {review.source === 'Google' && (
                <svg class="w-5 h-5 text-ink-600" viewBox="0 0 24 24"><path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
              )}
            </div>
          </div>
        ))}
      </div>
      {shop.google_reviews_enabled && (
        <div class="reveal text-center mt-12">
          <a href={shop.google_reviews_url} target="_blank" rel="noopener" class="btn-outline text-xs">
            Read more on Google
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      )}
    </div>
  </section>
  <div class="divider-line max-w-7xl mx-auto"></div>

  <!-- ==================== FAQ ==================== -->
  <section id="faq" class="py-24 md:py-32">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="reveal mb-12">
        <span class="text-xs font-medium uppercase tracking-[0.2em] text-accent">Common questions</span>
        <h2 class="font-display text-4xl md:text-5xl font-semibold text-ink-50 mt-3">FAQ</h2>
      </div>
      <div class="space-y-4" id="faq-accordion">
        {shop.faq.map((item: any, i: number) => (
          <div class="reveal border border-ink-800/40 bg-surface-raised overflow-hidden" style={`animation-delay: ${i * 0.05}s`}>
            <button class="faq-toggle w-full flex items-center justify-between px-6 py-5 text-left group" aria-expanded="false">
              <span class="text-sm font-medium text-ink-200 group-hover:text-ink-50 transition-colors pr-4">{item.question}</span>
              <svg class="w-4 h-4 text-ink-500 flex-shrink-0 transition-transform duration-300 faq-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="faq-content max-h-0 overflow-hidden transition-all duration-300">
              <div class="px-6 pb-5">
                <p class="text-sm text-ink-400 leading-relaxed">{item.answer}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <div class="divider-line max-w-7xl mx-auto"></div>

  <!-- ==================== FACEBOOK FEED ==================== -->
  {shop.features.facebook_feed && (
    <section id="updates" class="py-24 md:py-32">
      <div class="max-w-4xl mx-auto px-6 lg:px-8">
        <div class="reveal mb-12 text-center">
          <span class="text-xs font-medium uppercase tracking-[0.2em] text-accent">Latest updates</span>
          <h2 class="font-display text-4xl md:text-5xl font-semibold text-ink-50 mt-3">From our Facebook</h2>
          <p class="text-ink-400 mt-4 max-w-xl mx-auto">See our latest work, shop updates, and availability.</p>
        </div>
        <div class="reveal bg-surface-raised border border-ink-800/30 p-4 md:p-6 flex justify-center">
          <div id="fb-feed-container" class="w-full max-w-[500px]">
            <div id="fb-root"></div>
            <div class="fb-page"
              data-href={shop.facebook_page_url}
              data-tabs="timeline"
              data-width="500"
              data-height="600"
              data-small-header="true"
              data-adapt-container-width="true"
              data-hide-cover="false"
              data-show-facepile="false">
              <blockquote cite={shop.facebook_page_url} class="fb-xfbml-parse-ignore">
                <a href={shop.facebook_page_url} class="text-accent hover:text-accent-light transition-colors text-sm">Follow us on Facebook</a>
              </blockquote>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}
  <div class="divider-line max-w-7xl mx-auto"></div>

  <!-- ==================== CONTACT ==================== -->
  <section id="contact" class="py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <div class="reveal">
          <span class="text-xs font-medium uppercase tracking-[0.2em] text-accent">Get in touch</span>
          <h2 class="font-display text-4xl md:text-5xl font-semibold text-ink-50 mt-3 mb-8">Visit the studio</h2>
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-accent/10">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <p class="text-sm font-medium text-ink-200">{shop.address.street}</p>
                <p class="text-sm text-ink-400">{shop.address.suburb}, {shop.address.state} {shop.address.postcode}</p>
                <a href={shop.address.google_maps_link} target="_blank" rel="noopener" class="text-xs text-accent hover:text-accent-light transition-colors mt-1 inline-block">Get directions &rarr;</a>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-accent/10">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <a href={`tel:${shop.phone}`} class="text-sm font-medium text-ink-200 hover:text-ink-50 transition-colors">{shop.phone}</a>
                <p class="text-xs text-ink-500 mt-0.5">Call or text</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-accent/10">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <a href={`mailto:${shop.email}`} class="text-sm font-medium text-ink-200 hover:text-ink-50 transition-colors">{shop.email}</a>
              </div>
            </div>
            <div class="mt-8">
              <h3 class="text-xs font-medium uppercase tracking-widest text-ink-500 mb-4">Studio hours</h3>
              <div class="space-y-2">
                {shop.hours.map((h: any) => (
                  <div class="flex justify-between text-sm">
                    <span class="text-ink-400">{h.day}</span>
                    <span class={h.open === 'Closed' ? 'text-ink-600' : 'text-ink-200'}>
                      {h.open === 'Closed' ? 'Closed' : `${h.open} — ${h.close}`}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
        <div class="reveal" style="animation-delay: 0.15s">
          <div class="aspect-[4/3] bg-surface-raised border border-ink-800/30 overflow-hidden">
            <iframe
              src={shop.address.google_maps_embed}
              width="100%" height="100%"
              style="border:0; filter: invert(90%) hue-rotate(180deg) brightness(0.95) contrast(0.9);"
              allowfullscreen loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Studio location"
            ></iframe>
          </div>
          <div class="mt-6 flex items-center gap-4">
